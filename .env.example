# Copy this file to .env and fill in real values. See README.md for details on each variable.
# Environment variables declared here are NOT automatically loaded by Prisma —
# they're loaded via `import "dotenv/config"` in prisma.config.ts, and natively by Next.js.

# Postgres connection string. Use `npx prisma dev` for a local dev server, or a hosted
# Postgres (e.g. Neon) for anything shared/deployed.
DATABASE_URL=""

# Auth.js (next-auth v4). Generate a real secret for any shared/deployed environment,
# e.g.: openssl rand -base64 32
NEXTAUTH_SECRET=""
NEXTAUTH_URL="http://localhost:3000"

# Google OAuth (optional — leave blank to disable the Google sign-in button)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# OpenAI (required for the AI Starter advisor and the AI Copilot)
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5.4-mini"
