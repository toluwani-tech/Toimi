// Toimi — Phase 0 + Module 1 (AI Business Starter) schema.
// Only entities needed for auth/RBAC foundation and the AI Starter advisor.
// CRM/Quote/Job/Invoice/Expense models are intentionally not modeled yet —
// they'll be designed when those modules are actually built.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  companyMembers CompanyMember[]
  aiChatSessions AIChatSession[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Company / RBAC ----------

enum CompanyForm {
  TOIMINIMI
  OY
  UNDECIDED
}

enum CompanyRole {
  SUPER_ADMIN
  ADMIN
  OWNER
  MANAGER
  EMPLOYEE
  ACCOUNTANT
}

model Company {
  id         String      @id @default(cuid())
  name       String
  businessId String? // Finnish Y-tunnus, assigned once registered
  form       CompanyForm @default(UNDECIDED)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  members CompanyMember[]
}

model CompanyMember {
  id        String      @id @default(cuid())
  userId    String
  companyId String
  role      CompanyRole
  createdAt DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

// ---------- AI Business Starter (Module 1) ----------

enum StarterSessionStatus {
  GATHERING_INFO
  ADVISING
  PLAN_READY
}

model AIChatSession {
  id        String               @id @default(cuid())
  userId    String? // null until an anonymous visitor signs up mid-conversation
  trade     String? // e.g. "sähköasentaja", "putkimies"
  status    StarterSessionStatus @default(GATHERING_INFO)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages AIChatMessage[]
  plan     StarterPlan?
}

enum StarterMessageRole {
  USER
  ASSISTANT
}

model AIChatMessage {
  id        String              @id @default(cuid())
  sessionId String
  role      StarterMessageRole
  content   String              @db.Text
  createdAt DateTime            @default(now())

  session AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model StarterPlan {
  id                      String   @id @default(cuid())
  sessionId               String   @unique
  companyFormRecommendation CompanyForm
  companyFormReasoning    String   @db.Text
  registrationChecklist   Json // ordered list of { step, description }
  vatYelSummary           String   @db.Text
  insurancePermitNotes    String   @db.Text
  pricingGuidance         String   @db.Text
  nextSteps               Json // ordered list of strings
  createdAt               DateTime @default(now())

  session AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}
