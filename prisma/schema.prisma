// Toimi — Phase 0 + Module 1 (AI Business Starter) schema.
// Only entities needed for auth/RBAC foundation and the AI Starter advisor.
// CRM/Quote/Job/Invoice/Expense models are intentionally not modeled yet —
// they'll be designed when those modules are actually built.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Auth ----------

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  name          String?
  image         String?
  passwordHash  String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  accounts       Account[]
  sessions       Session[]
  companyMembers CompanyMember[]
  aiChatSessions AIChatSession[]
  customerNotes  CustomerNote[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// ---------- Company / RBAC ----------

enum CompanyForm {
  TOIMINIMI
  OY
  UNDECIDED
}

enum CompanyRole {
  SUPER_ADMIN
  ADMIN
  OWNER
  MANAGER
  EMPLOYEE
  ACCOUNTANT
}

model Company {
  id         String      @id @default(cuid())
  name       String
  businessId String? // Finnish Y-tunnus, assigned once registered
  form       CompanyForm @default(UNDECIDED)
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  members   CompanyMember[]
  customers Customer[]
  quotes    Quote[]
}

model CompanyMember {
  id        String      @id @default(cuid())
  userId    String
  companyId String
  role      CompanyRole
  createdAt DateTime    @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  company Company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([userId, companyId])
}

// ---------- AI Business Starter (Module 1) ----------

enum StarterSessionStatus {
  GATHERING_INFO
  ADVISING
  PLAN_READY
}

model AIChatSession {
  id        String               @id @default(cuid())
  userId    String? // null until an anonymous visitor signs up mid-conversation
  trade     String? // e.g. "sähköasentaja", "putkimies"
  status    StarterSessionStatus @default(GATHERING_INFO)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt

  user     User?           @relation(fields: [userId], references: [id], onDelete: SetNull)
  messages AIChatMessage[]
  plan     StarterPlan?
}

enum StarterMessageRole {
  USER
  ASSISTANT
}

model AIChatMessage {
  id        String              @id @default(cuid())
  sessionId String
  role      StarterMessageRole
  content   String              @db.Text
  createdAt DateTime            @default(now())

  session AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model StarterPlan {
  id                      String   @id @default(cuid())
  sessionId               String   @unique
  companyFormRecommendation CompanyForm
  companyFormReasoning    String   @db.Text
  registrationChecklist   Json // ordered list of { step, description }
  vatYelSummary           String   @db.Text
  insurancePermitNotes    String   @db.Text
  pricingGuidance         String   @db.Text
  nextSteps               Json // ordered list of strings
  createdAt               DateTime @default(now())

  session AIChatSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
}

// ---------- CRM (Module 2) ----------

enum CustomerType {
  INDIVIDUAL
  ORGANIZATION
}

model Customer {
  id         String       @id @default(cuid())
  companyId  String
  type       CustomerType @default(INDIVIDUAL)
  name       String
  email      String?
  phone      String?
  businessId String? // Y-tunnus, organization customers only
  street     String?
  postalCode String?
  city       String?
  createdAt  DateTime     @default(now())
  updatedAt  DateTime     @updatedAt

  company Company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  notes   CustomerNote[]
  quotes  Quote[]

  @@index([companyId])
}

model CustomerNote {
  id         String   @id @default(cuid())
  customerId String
  authorId   String
  content    String   @db.Text
  createdAt  DateTime @default(now())

  customer Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  author   User     @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([customerId, createdAt])
}

// ---------- Quotes (Module 3) ----------

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

enum QuoteLineItemType {
  LABOR
  MATERIAL
}

model Quote {
  id                String      @id @default(cuid())
  companyId         String
  customerId        String
  number            Int // sequential per company, shown as "Tarjous #7"
  status            QuoteStatus @default(DRAFT)
  title             String?
  vatRatePercent    Int         @default(25)
  reverseVatApplies Boolean     @default(false)
  discountPercent   Int         @default(0)
  notes             String?     @db.Text
  sentAt            DateTime?
  respondedAt       DateTime?
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  company  Company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  customer Customer        @relation(fields: [customerId], references: [id], onDelete: Restrict)
  items    QuoteLineItem[]

  @@unique([companyId, number])
  @@index([companyId])
}

model QuoteLineItem {
  id             String            @id @default(cuid())
  quoteId        String
  type           QuoteLineItemType @default(LABOR)
  description    String
  quantity       Float             @default(1)
  unitPriceCents Int
  position       Int               @default(0)

  quote Quote @relation(fields: [quoteId], references: [id], onDelete: Cascade)

  @@index([quoteId, position])
}
